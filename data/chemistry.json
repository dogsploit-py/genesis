      "products":  [ {"formula":"ZnO","phase":"s","n":2}, {"formula":"SO2","phase":"g","n":2} ] },

    { "name": "Carbothermic reduction of zinc oxide", "class": "Reduction",
      "A": 1e8, "Ea": 250, "minT": 1200,
      "reactants": [ {"formula":"ZnO","phase":"s","n":1}, {"formula":"C","phase":"s","n":1} ],
      "products":  [ {"formula":"Zn","phase":"s","n":1}, {"formula":"CO","phase":"g","n":1} ],
      "note": "Zinc boils at 1180 K, below its own reduction temperature, so it comes off as vapour and must be condensed. Miss that and your zinc goes up the chimney." },

    { "name": "Roasting of cinnabar", "class": "Oxidation",
      "A": 1e7, "Ea": 130, "minT": 700,
      "reactants": [ {"formula":"HgS","phase":"s","n":1}, {"formula":"O2","phase":"g","n":1} ],
      "products":  [ {"formula":"Hg","phase":"l","n":1}, {"formula":"SO2","phase":"g","n":1} ] },

    { "name": "Hydrogen reduction of tungsten trioxide", "class": "Reduction",
      "A": 1e8, "Ea": 240, "minT": 1000,
      "reactants": [ {"formula":"WO3","phase":"s","n":1}, {"formula":"H2","phase":"g","n":3} ],
      "products":  [ {"formula":"W","phase":"s","n":1}, {"formula":"H2O","phase":"g","n":3} ],
      "note": "Carbon would make a carbide, so tungsten needs hydrogen instead." },

    // ---- water gas, ammonia, acid ----
    { "name": "Water gas reaction", "class": "Reduction",
      "A": 1e7, "Ea": 200, "minT": 1000,
      "reactants": [ {"formula":"C","phase":"s","n":1}, {"formula":"H2O","phase":"g","n":1} ],
      "products":  [ {"formula":"CO","phase":"g","n":1}, {"formula":"H2","phase":"g","n":1} ],
      "note": "Steam over hot coke. The industrial source of hydrogen before anything else." },

    { "name": "Haber-Bosch synthesis", "class": "Synthesis", "reversible": true,
      "A": 1e8, "Ea": 230, "EaCatalysed": 95, "catalyst": "Fe",
      "minT": 670, "minP": 15000000,
      "reactants": [ {"formula":"N2","phase":"g","n":1}, {"formula":"H2","phase":"g","n":3} ],
      "products":  [ {"formula":"NH3","phase":"g","n":2} ],
      "note": "Needs high pressure AND an iron catalyst. Fewer gas molecules on the right, so Le Chatelier says pressure pushes it forward -- but without the catalyst it is far too slow to matter at any temperature the equilibrium tolerates." },

    { "name": "Contact process", "class": "Oxidation", "reversible": true,
      "A": 1e8, "Ea": 250, "EaCatalysed": 90, "catalyst": "V2O5", "minT": 700,
      "reactants": [ {"formula":"SO2","phase":"g","n":2}, {"formula":"O2","phase":"g","n":1} ],
      "products":  [ {"formula":"SO3","phase":"g","n":2} ] },

    { "name": "Hydration of sulfur trioxide", "class": "Synthesis",
      "A": 1e9, "Ea": 30,
      "reactants": [ {"formula":"SO3","phase":"g","n":1}, {"formula":"H2O","phase":"l","n":1} ],
      "products":  [ {"formula":"H2SO4","phase":"l","n":1} ] },

    { "name": "Neutralisation of caustic soda", "class": "AcidBase",
      "A": 1e11, "Ea": 15,
