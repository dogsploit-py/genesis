    { "name": "Soda-lime glass melt", "class": "Synthesis",
      "A": 1e7, "Ea": 260, "minT": 1400,
      "reactants": [ {"formula":"SiO2","phase":"s","n":1}, {"formula":"Na2CO3","phase":"s","n":1} ],
      "products":  [ {"formula":"Na2SiO3","phase":"s","n":1}, {"formula":"CO2","phase":"g","n":1} ],
      "note": "Soda ash drops silica's melting point by hundreds of degrees. Without that trick glass is unreachable." },

    { "name": "Alcoholic fermentation", "class": "Fermentation",
      "A": 1e5, "Ea": 60,
      "reactants": [ {"formula":"C6H12O6","phase":"s","n":1} ],
      "products":  [ {"formula":"C2H5OH","phase":"l","n":2}, {"formula":"CO2","phase":"g","n":2} ] },

    { "name": "Acetic fermentation", "class": "Fermentation",
      "A": 1e5, "Ea": 70,
      "reactants": [ {"formula":"C2H5OH","phase":"l","n":1}, {"formula":"O2","phase":"g","n":1} ],
      "products":  [ {"formula":"CH3COOH","phase":"l","n":1}, {"formula":"H2O","phase":"l","n":1} ] },

    { "name": "Saponification of fat", "class": "Saponification",
      "A": 1e6, "Ea": 65, "minT": 340,
      "reactants": [ {"formula":"C57H110O6","phase":"s","n":1}, {"formula":"NaOH","phase":"s","n":3} ],
      "products":  [ {"formula":"C3H8O3","phase":"l","n":1}, {"formula":"C18H35NaO2","phase":"s","n":3} ],
      "note": "Fat plus wood-ash lye gives soap and glycerol. Discoverable by accident, and it was." },

    { "name": "Polymerisation of ethylene", "class": "Polymerisation",
      "A": 1e7, "Ea": 90, "minP": 10000000,
      "reactants": [ {"formula":"C2H4","phase":"g","n":1} ],
      "products":  [ {"formula":"C2H4","phase":"s","n":1} ],
      "note": "Same composition, different substance. Polymerisation rearranges structure, not atoms, which is why both sides of this equation look identical." },

    { "name": "Catalytic cracking", "class": "Cracking",
      "A": 1e8, "Ea": 200, "minT": 750,
      "reactants": [ {"formula":"C16H34","phase":"l","n":1} ],
      "products":  [ {"formula":"C8H18","phase":"l","n":1}, {"formula":"C8H16","phase":"l","n":1} ],
      "note": "Long hydrocarbons broken into short ones. Heavy oil into petrol." },

    { "name": "Photosynthesis", "class": "Synthesis",
      "A": 1e4, "Ea": 50,
      "reactants": [ {"formula":"CO2","phase":"g","n":6}, {"formula":"H2O","phase":"l","n":6} ],
      "products":  [ {"formula":"C6H12O6","phase":"s","n":1}, {"formula":"O2","phase":"g","n":6} ],
      "note": "Strongly uphill: the free energy comes from sunlight, not from the reagents. Listed here because it is the reaction the entire food web runs on." },

    { "name": "Respiration", "class": "Combustion",
      "A": 1e5, "Ea": 55,
      "reactants": [ {"formula":"C6H12O6","phase":"s","n":1}, {"formula":"O2","phase":"g","n":6} ],
      "products":  [ {"formula":"CO2","phase":"g","n":6}, {"formula":"H2O","phase":"l","n":6} ],
      "note": "Combustion run slowly and in stages. The same chemistry as a fire, at body temperature." },

    { "name": "Gunpowder deflagration", "class": "Combustion", "ignition": true,
      "A": 1e11, "Ea": 100,
      "reactants": [ {"formula":"KNO3","phase":"s","n":2}, {"formula":"S","phase":"s","n":1}, {"formula":"C","phase":"s","n":3} ],
      "products":  [ {"formula":"K2S","phase":"s","n":1}, {"formula":"N2","phase":"g","n":1}, {"formula":"CO2","phase":"g","n":3} ],
      "note": "Three solids into two gases and a solid. The oxidiser is built in, so it burns without air -- that is what makes it a propellant rather than a fuel." },

    // ---- nuclear, gated behind conditions nothing early can reach ----
    { "name": "Fission of uranium-235", "class": "Nuclear",
      "A": 1e12, "Ea": 20, "minT": 300, "energyMeV": 202.5,
