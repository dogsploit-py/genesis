      "products":  [ {"formula":"Fe","phase":"s","n":2}, {"formula":"CO2","phase":"g","n":3} ],
      "note": "The bloomery reaction. Needs both the temperature and a reducing atmosphere, which is why iron is thousands of years behind copper." },

    { "name": "Reduction of magnetite by carbon monoxide", "class": "Reduction",
      "A": 1e9, "Ea": 240, "minT": 1250,
      "reactants": [ {"formula":"Fe3O4","phase":"s","n":1}, {"formula":"CO","phase":"g","n":4} ],
      "products":  [ {"formula":"Fe","phase":"s","n":3}, {"formula":"CO2","phase":"g","n":4} ] },

    { "name": "Direct carbothermic reduction of hematite", "class": "Reduction",
      "A": 1e9, "Ea": 290, "minT": 1500,
      "reactants": [ {"formula":"Fe2O3","phase":"s","n":2}, {"formula":"C","phase":"s","n":3} ],
      "products":  [ {"formula":"Fe","phase":"s","n":4}, {"formula":"CO2","phase":"g","n":3} ] },

    { "name": "Carburisation of iron", "class": "Synthesis",
      "A": 1e6, "Ea": 160, "minT": 1000,
      "reactants": [ {"formula":"Fe","phase":"s","n":3}, {"formula":"C","phase":"s","n":1} ],
      "products":  [ {"formula":"Fe3C","phase":"s","n":1} ],
      "note": "Carbon dissolving into hot iron. How much of it, and how it is then cooled, is the entire difference between wrought iron and steel." },

    { "name": "Rusting of iron", "class": "Oxidation",
      "A": 1e2, "Ea": 55,
      "reactants": [ {"formula":"Fe","phase":"s","n":4}, {"formula":"O2","phase":"g","n":3} ],
      "products":  [ {"formula":"Fe2O3","phase":"s","n":2} ],
      "note": "Strongly downhill and very slow: the low pre-exponential factor is why iron tools last years rather than hours." },

    { "name": "Thermite reaction", "class": "Reduction", "ignition": true,
      "A": 1e10, "Ea": 200,
      "reactants": [ {"formula":"Al","phase":"s","n":2}, {"formula":"Fe2O3","phase":"s","n":1} ],
      "products":  [ {"formula":"Al2O3","phase":"s","n":1}, {"formula":"Fe","phase":"s","n":2} ],
      "note": "Aluminium wants oxygen more than iron does, and the difference comes out as enough heat to melt the iron it makes." },

    // ---- other metals ----
    { "name": "Roasting of galena", "class": "Oxidation",
      "A": 1e8, "Ea": 170, "minT": 870,
      "reactants": [ {"formula":"PbS","phase":"s","n":2}, {"formula":"O2","phase":"g","n":3} ],
      "products":  [ {"formula":"PbO","phase":"s","n":2}, {"formula":"SO2","phase":"g","n":2} ] },

    { "name": "Reduction of litharge", "class": "Reduction",
      "A": 1e8, "Ea": 110, "minT": 700,
      "reactants": [ {"formula":"PbO","phase":"s","n":1}, {"formula":"CO","phase":"g","n":1} ],
      "products":  [ {"formula":"Pb","phase":"s","n":1}, {"formula":"CO2","phase":"g","n":1} ],
      "note": "Easy: lead smelts at temperatures a domestic hearth reaches, which is why lead poisoning is ancient." },

    { "name": "Roasting of sphalerite", "class": "Oxidation",
