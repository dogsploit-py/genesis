      "products":  [ {"formula":"NaCl","phase":"s","n":1}, {"formula":"H2O","phase":"l","n":1} ],
      "note": "Acid plus base gives salt plus water. Fast, and downhill at any temperature." },

    // ---- electrochemistry ----
    { "name": "Electrolysis of water", "class": "Electrolysis", "electricity": true,
      "A": 1e6, "Ea": 60,
      "reactants": [ {"formula":"H2O","phase":"l","n":2} ],
      "products":  [ {"formula":"H2","phase":"g","n":2}, {"formula":"O2","phase":"g","n":1} ],
      "note": "Thermodynamically uphill, which is exactly why it needs electricity: the current supplies the free energy the reaction cannot find on its own." },

    { "name": "Chlor-alkali process", "class": "Electrolysis", "electricity": true,
      "A": 1e6, "Ea": 80,
      "reactants": [ {"formula":"NaCl","phase":"s","n":2}, {"formula":"H2O","phase":"l","n":2} ],
      "products":  [ {"formula":"NaOH","phase":"s","n":2}, {"formula":"Cl2","phase":"g","n":1}, {"formula":"H2","phase":"g","n":1} ],
      "note": "Salt and water into caustic soda, chlorine and hydrogen. Three industrial staples from seawater and a generator." },

    { "name": "Hall-Heroult process", "class": "Electrolysis", "electricity": true,
      "A": 1e6, "Ea": 120, "minT": 1230,
      "reactants": [ {"formula":"Al2O3","phase":"s","n":2} ],
      "products":  [ {"formula":"Al","phase":"s","n":4}, {"formula":"O2","phase":"g","n":3} ],
      "note": "The reason aluminium is a modern metal despite being the commonest in the crust: nothing chemical will pull that oxygen off, so it takes brute electrical force." },

